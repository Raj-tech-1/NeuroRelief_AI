# Copy this file to .env (same folder) and fill in your own values. Never commit .env.

# REQUIRED: secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Optional: API port (default 8000). The frontend expects 8000.
# PORT=8000

# Optional: command that runs Python for pain predictions (default: py -3.13).
#   Windows example: py -3.13      macOS/Linux example: python3
# PYTHON_CMD=py -3.13

# Optional: Google Gemini key for the voice/chat assistant. Without it the assistant shows "not configured".
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Report Audit (see README "Enable Report Audit"). Path to a key file OUTSIDE the project and OneDrive.
# REPORT_MASTER_KEY_FILE=C:\Users\<you>\AppData\Local\NeuroRelief\secrets\report-master-key.txt
# REPORT_MASTER_KEY_ID=k1
# Optional: where uploaded PDF reports are stored (encrypted). Default: %LOCALAPPDATA%\NeuroRelief\report-files
# REPORT_STORAGE_DIR=

# Optional: password for the five fictional demo doctors created by scripts/seed-demo-doctors.js (min 8 chars)
# DEMO_DOCTOR_PASSWORD=
